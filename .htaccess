# Enable URL Rewriting
RewriteEngine On

# Redirect non-www to www
RewriteCond %{HTTP_HOST} !^www\.veddia\.com$ [NC]
RewriteRule ^(.*)$ https://www.veddia.com/$1 [L,R=301]

# php -- BEGIN cPanel-generated handler, do not edit
# Set the "ea-php82" package as the default "PHP" programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-ea-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit

# Set the base directory (if site is in a subdirectory, adjust this)
RewriteBase /

# If the requested file or directory exists, serve it directly
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d

# Redirect requests without .php extension to .php files
RewriteRule ^([a-zA-Z0-9_-]+)$ $1.php [L,QSA]

# Optional: Redirect .php URLs to clean URLs (301 redirect)
# This ensures old .php links redirect to clean URLs
RewriteCond %{THE_REQUEST} \s/([^.]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]

# Handle trailing slashes - remove them
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.+)/$ /$1 [R=301,L]

# Security - Deny access to sensitive files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Deny access to config files
<FilesMatch "\.(sql|log|ini|config)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Custom error pages (optional)
# ErrorDocument 404 /404.php
# ErrorDocument 500 /500.php
